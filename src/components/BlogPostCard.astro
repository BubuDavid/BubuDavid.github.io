---
import TagPill from './TagPill.astro';

interface Props {
  title: string;
  description: string;
  topic: string;
  slug: string;
  publishedDate: string;
  tags: string[];
}

const { title, description, topic, slug, publishedDate, tags } = Astro.props;
const date = new Date(publishedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={`/portfolio/blog/${slug}`}
  class="block bg-surface border border-surface-border rounded-2xl p-6 hover:shadow-[0_4px_20px_rgba(61,44,30,0.1)] hover:-translate-y-1 transition-all duration-300"
>
  <div class="flex items-center gap-2 text-xs text-text-muted mb-2">
    <time datetime={publishedDate}>{date}</time>
  </div>
  <h3 class="font-heading text-lg font-semibold mb-2">{title}</h3>
  <p class="text-text-muted text-sm mb-3 line-clamp-2">{description}</p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => <TagPill label={tag} />)}
  </div>
</a>
