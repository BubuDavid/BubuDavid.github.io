---
interface Props {
  topic: string;
  label: string;
  postCount: number;
}

const { topic, label, postCount } = Astro.props;
---

<a
  href={`/portfolio/blog/${topic}`}
  class="block bg-surface border border-surface-border rounded-2xl p-6 hover:shadow-[0_4px_20px_rgba(61,44,30,0.1)] hover:-translate-y-1 transition-all duration-300"
>
  <h3 class="font-heading text-xl font-semibold mb-2">{label}</h3>
  <p class="text-text-muted text-sm">
    {postCount} {postCount === 1 ? 'post' : 'posts'}
  </p>
</a>
