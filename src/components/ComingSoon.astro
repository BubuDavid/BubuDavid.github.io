---
interface Props {
  title?: string;
  message?: string;
}

const { title = 'Coming Soon', message = 'This feature is under construction. Check back later!' } = Astro.props;
---

<div class="flex flex-col items-center justify-center py-24 text-center">
  <div class="text-6xl mb-6">🚧</div>
  <h1 class="font-heading text-3xl sm:text-4xl font-bold mb-4">{title}</h1>
  <p class="text-text-muted text-lg max-w-md">{message}</p>
  <a href="/portfolio/" class="mt-8 inline-block px-6 py-3 bg-accent text-white rounded-full font-medium hover:bg-accent-secondary transition-colors">
    Go Home
  </a>
</div>
