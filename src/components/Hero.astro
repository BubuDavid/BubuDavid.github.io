---
import SocialBar from './SocialBar.astro';
---

<section class="py-16 sm:py-24">
  <div class="flex flex-col sm:flex-row items-center gap-8 sm:gap-12">
    <!-- Profile photo -->
    <div class="shrink-0">
      <div class="w-36 h-36 sm:w-44 sm:h-44 rounded-full border-4 border-accent-secondary shadow-lg overflow-hidden bg-surface">
        <img
          src="/portfolio/assets/images/profile.jpg"
          alt="Bubu"
          class="w-full h-full object-cover"
          onerror="this.style.display='none'"
        />
      </div>
    </div>

    <!-- Text -->
    <div class="text-center sm:text-left">
      <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold mb-3">
        Hey, I'm <span class="text-accent">Bubu</span>
      </h1>
      <p class="text-lg sm:text-xl text-text-muted max-w-xl mb-6">
        Software engineer, physicist, and lifelong learner. I build things for the web,
        explore data, and share what I learn along the way.
      </p>
      <SocialBar />
    </div>
  </div>
</section>
