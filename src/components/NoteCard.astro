---
import TagPill from './TagPill.astro';

interface Props {
  title: string;
  publishedDate: string;
  tags: string[];
  mood?: string;
  body: string;
}

const { title, publishedDate, tags, mood, body } = Astro.props;
const date = new Date(publishedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<div class="bg-surface border border-surface-border rounded-2xl p-6 hover:shadow-[0_2px_15px_rgba(61,44,30,0.08)] transition-all duration-300">
  <div class="flex items-center gap-2 text-xs text-text-muted mb-2">
    <time datetime={publishedDate}>{date}</time>
    {mood && <span>· {mood}</span>}
  </div>
  <h3 class="font-heading text-lg font-semibold mb-2">{title}</h3>
  <div class="text-text-muted text-sm mb-3 prose prose-sm max-w-none" set:html={body} />
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => <TagPill label={tag} />)}
  </div>
</div>
