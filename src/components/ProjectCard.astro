---
import TagPill from './TagPill.astro';

interface Props {
  title: string;
  description: string;
  tags: string[];
  image?: string;
  liveUrl?: string;
  repoUrl?: string;
}

const { title, description, tags, image, liveUrl, repoUrl } = Astro.props;
---

<div class="bg-surface border border-surface-border rounded-2xl overflow-hidden hover:shadow-[0_4px_20px_rgba(61,44,30,0.1)] hover:-translate-y-1 transition-all duration-300 flex flex-col">
  {image && (
    <img src={image} alt={title} class="w-full h-48 object-cover" />
  )}
  <div class="p-6 flex flex-col flex-1">
    <h3 class="font-heading text-xl font-semibold mb-2">{title}</h3>
    <p class="text-text-muted text-sm mb-4 flex-1">{description}</p>
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map((tag) => <TagPill label={tag} />)}
    </div>
    <div class="flex gap-3">
      {liveUrl && (
        <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-accent hover:underline">
          Live Demo →
        </a>
      )}
      {repoUrl && (
        <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-medium text-text-muted hover:text-text hover:underline">
          Source Code
        </a>
      )}
    </div>
  </div>
</div>
