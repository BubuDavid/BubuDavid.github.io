---
import TagPill from './TagPill.astro';

interface Props {
  title: string;
  description: string;
  category: string;
  url?: string;
  tags: string[];
}

const { title, description, category, url, tags } = Astro.props;
const Tag = url ? 'a' : 'div';
---

<Tag
  href={url}
  target={url ? '_blank' : undefined}
  rel={url ? 'noopener noreferrer' : undefined}
  class="block bg-surface border border-surface-border rounded-2xl p-6 hover:shadow-[0_4px_20px_rgba(61,44,30,0.1)] hover:-translate-y-1 transition-all duration-300"
>
  <span class="text-xs font-mono text-accent-secondary uppercase tracking-wide">{category}</span>
  <h3 class="font-heading text-lg font-semibold mt-1 mb-2">{title}</h3>
  <p class="text-text-muted text-sm mb-3">{description}</p>
  <div class="flex flex-wrap gap-2">
    {tags.map((tag) => <TagPill label={tag} />)}
  </div>
</Tag>
