---
import PageLayout from './PageLayout.astro';
import TagPill from '../components/TagPill.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    topic: string;
    topicLabel: string;
    publishedDate: string;
    tags: string[];
    image?: string;
  };
}

const { frontmatter } = Astro.props;
const date = new Date(frontmatter.publishedDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<PageLayout title={frontmatter.title} description={frontmatter.description} image={frontmatter.image}>
  <article class="max-w-3xl mx-auto">
    <!-- Post header -->
    <header class="mb-10">
      <a
        href={`/portfolio/blog/${frontmatter.topic}`}
        class="inline-block text-sm font-medium text-accent hover:underline mb-3"
      >
        ← {frontmatter.topicLabel}
      </a>
      <h1 class="font-heading text-4xl sm:text-5xl font-bold mb-4 leading-tight">
        {frontmatter.title}
      </h1>
      <p class="text-text-muted text-lg mb-4">{frontmatter.description}</p>
      <div class="flex flex-wrap items-center gap-3 text-sm text-text-muted">
        <time datetime={frontmatter.publishedDate}>{date}</time>
        <span>·</span>
        <div class="flex flex-wrap gap-2">
          {frontmatter.tags.map((tag) => <TagPill label={tag} />)}
        </div>
      </div>
    </header>

    <!-- Post content -->
    <div class="prose prose-lg max-w-none font-body
      prose-headings:font-heading prose-headings:text-text
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline
      prose-code:font-mono prose-code:text-sm
      prose-pre:bg-surface prose-pre:border prose-pre:border-surface-border prose-pre:rounded-xl
      prose-img:rounded-xl prose-img:shadow-md
      prose-blockquote:border-accent-secondary prose-blockquote:text-text-muted">
      <slot />
    </div>
  </article>
</PageLayout>
