---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="404 — Bubu">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <div class="text-7xl font-heading font-bold text-accent mb-4">404</div>
    <h1 class="font-heading text-2xl sm:text-3xl font-bold mb-4">Page not found</h1>
    <p class="text-text-muted text-lg max-w-md mb-8">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/portfolio/" class="inline-block px-6 py-3 bg-accent text-white rounded-full font-medium hover:bg-accent-secondary transition-colors">
      Go Home
    </a>
    <div id="breakout-container" class="mt-4"></div>
  </div>

  <script>
    import '../scripts/games/breakout-404';
  </script>
</PageLayout>
